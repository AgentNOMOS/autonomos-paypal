# AutoNOMOS configuration example (R1e.1). Never commit real values; keep a filled copy OUTSIDE the repository, mode 0600.
#
# Payment
AUTONOMOS_PAYMENT_PROVIDER=mock               # mock | paypal_sandbox  (live PayPal hosts are refused in code)
PAYPAL_CLIENT_ID=                             # Sandbox REST app client id
PAYPAL_CLIENT_SECRET=                         # Sandbox REST app secret (server-side only)
PAYPAL_MERCHANT_ID=                           # Sandbox BUSINESS account id = the expected payee
AUTONOMOS_SANDBOX_OWNER_GO=                   # set to capture-at-most-1-order to allow paypal_sandbox; credentials alone are not permission
AUTONOMOS_SANDBOX_MAX_ORDERS=1                # hard cap per data directory
AUTONOMOS_SANDBOX_MAX_CAPTURE_REQUESTS=1      # hard cap on capture POSTs per data directory (code default 2; demos use 1)
AUTONOMOS_ENV_FILE=                           # path of this file, so sandbox-preflight can check it is private and outside the repo
#
# AI
AUTONOMOS_AI_PROVIDER=fixture                 # legacy R0 setting: must stay "fixture" (R1d refuses the old paths)
AUTONOMOS_R1D_AI_PROVIDER=recorded            # fixture | mock | recorded | anthropic_real
# anthropic_real only (billed to your key); ANTHROPIC_API_KEY must be UNSET:
AUTONOMOS_ANTHROPIC_KEY_FILE=                 # file holding only the key, 0600, outside the repo
AUTONOMOS_R1D_AI_AUTHORIZATION=               # authorization JSON, 0600, outside the repo (template: live_demo/)
AUTONOMOS_R1D_REAL_AI_GO=                     # real-ai:<authorization_id>
#
# Server
AUTONOMOS_DEMO_MODE=                          # empty (development) | DEMO_REPLAY (mock + recorded only)
AUTONOMOS_DATA_DIR=/tmp/autonomos-data
AUTONOMOS_LISTEN_PORT=8765                    # always binds 127.0.0.1
AUTONOMOS_PUBLIC_BASE_URL=http://127.0.0.1:8765
